{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xka0085-byte/mcpreflight",
  "description": "Read-only preflight for any MCP or x402 endpoint: handshake, tool schemas, 402 drift.",
  "repository": {
    "url": "https://github.com/xka0085-byte/mcpreflight",
    "source": "github",
    "id": "1379135879"
  },
  "version": "0.6.0",
  "websiteUrl": "https://xka0085-byte.github.io/mcpreflight/",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@eidonze/mcpreflight",
      "version": "0.6.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y",
          "value": "true"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "mcpreflight-mcp",
          "value": "mcpreflight-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
